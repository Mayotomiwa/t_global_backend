# Copy this to .env and fill in your values

# Local development (SQLite-free — use a local Postgres or Docker)
DATABASE_URL=postgresql://postgres:password@localhost:5432/tglobal_db
NODE_ENV=development

# Production (Render will inject this automatically)
# DATABASE_URL=postgresql://user:pass@host/dbname
# NODE_ENV=production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=nestdb
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin